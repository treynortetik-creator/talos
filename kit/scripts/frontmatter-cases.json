   "hooks",
   "mcpServers",
   "it's"
  ]
 },
 {
  "name": "an escape in a key is unclear",
  "text": "---\n\"hoo\\x6bs\": x\n---\n",
  "unclear": true
 },
 {
  "name": "CRLF",
