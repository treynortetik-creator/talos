[
 {
  "name": "plain keys",
  "text": "---\nname: helper\ndescription: plain\ntools: Read, Grep\n---\nBody.\n",
  "keys": [
   "name",
   "description",
   "tools"
  ]
 },
 {
  "name": "no frontmatter",
  "text": "# Title\nhooks: x\n",
  "keys": []
 },
 {
  "name": "empty frontmatter",
  "text": "---\n---\nbody\n",
  "keys": []
 },
 {
  "name": "a key in the body is not frontmatter",
  "text": "---\nname: ok\n---\nhooks: none here\n",
  "keys": [
   "name"
  ]
 },
 {
  "name": "uniform indentation",
