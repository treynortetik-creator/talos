  "keys": [
   "name",
   "hooks"
  ]
 },
 {
  "name": "a whole flow mapping",
  "text": "---\n{name: a, hooks: {PreToolUse: []}}\n---\n",
  "keys": [
   "name",
   "hooks"
  ]
 },
 {
  "name": "a flow mapping over lines, quoted key",
  "text": "---\n{name: a,\n  \"allowed-tools\": [Bash, Read],\n  'mcpServers': {x: {}}}\n---\n",
  "keys": [
   "name",
   "allowed-tools",
   "mcpServers"
  ]
 },
 {
  "name": "quoted keys",
  "text": "---\n'hooks': x\n\"mcpServers\": {}\n'it''s': y\n---\n",
