+
+  /// The settings files' size cap: far past any real settings file, and a reader never holds a session's start on a big one.
+  public static let settingsCap = 256 * 1024
+
+  /// The bytes of `p` when it is a regular file (links followed) of at most `cap` bytes, read through one open descriptor that never
+  /// blocks; nil otherwise. A FIFO, a device (a link to /dev/zero) or a huge file at a settings path cannot hold the reader.
+  static func readSmall(_ p: String, cap: Int) -> Data? {
+    let fd = open(p, O_RDONLY | O_NONBLOCK | O_CLOEXEC)
+    guard fd >= 0 else { return nil }
+    let h = FileHandle(fileDescriptor: fd, closeOnDealloc: true)
+    var st = stat()
+    guard fstat(fd, &st) == 0, st.st_mode & S_IFMT == S_IFREG, st.st_size <= cap else { return nil }
+    guard let d = try? h.read(upToCount: cap + 1), d.count <= cap else { return nil }
+    return d
+  }
+
+  /// The folders whose project settings a session in `folder` reads: it, and its git roots (`gitRoots`), or why they are not known.
+  public static func settingsFolders(_ folder: String) -> (folders: [String], problem: String?) {
+    let me = resolved(folder) ?? folder
+    let g = gitRoots(of: folder)
+    return ([me] + g.roots.filter { $0 != me }, g.problem)
+  }
+
+  /// The two project settings files Claude Code reads in `folder`.
+  public static func projectSettingsFiles(_ folder: String) -> [String] {
+    let f = folder.hasSuffix("/") ? String(folder.dropLast()) : folder
+    return [f + "/.claude/settings.json", f + "/.claude/settings.local.json"]
+  }
+
+  /// Why the start in `folder` is refused for its project settings (or its git root's), or nil. A file that is there and cannot be
+  /// read as settings is a refusal too: what it would set is not known. `isAgentFolder`: `folder` is the agent folder.
+  public static func folderSettingsProblem(folder: String, isAgentFolder: Bool) -> String? {
+    let found = settingsFolders(folder)
+    if let why = found.problem { return why }
+    for (n, f) in found.folders.enumerated() {
