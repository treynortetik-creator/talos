+    """The bytes of a regular file (links followed) of at most `cap` bytes, through one descriptor that never blocks, else None:
+    a FIFO, a device or a huge file at a settings path cannot hold the hook."""
+    try:
+        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
+    except OSError:
+        return None
