diff --git a/apps/windows/TalosWin.ps1 b/apps/windows/TalosWin.ps1
new file mode 100644
index 00000000..85472667
--- /dev/null
+++ b/apps/windows/TalosWin.ps1
@@ -0,0 +1,97 @@
+<#
+  What install.ps1, add-folder.ps1 and uninstall.ps1 share (docs/WINDOWS-PLAN.md section 8), dot-sourced by each. Kept apart
+  so apps\windows\tests\TalosWin.Tests.ps1 (Pester 3.4, the one Windows ships) can test it without a distro.
+#>
+
+# wsl.exe by its full path (R1-11): a wsl.exe earlier on PATH, or in the current folder, is never the one run
+$script:WslExe = Join-Path $env:SystemRoot 'System32\wsl.exe'
+# a file in the distro that says Talos made it (R1-7): a distro without it is never set up, stopped or deleted by these scripts
+$script:TalosMarker = '/etc/talos-wsl/marker'
+
+if (-not ('TalosWin.FinalPath' -as [type])) {
+  Add-Type -TypeDefinition @'
+using System;
+using System.Runtime.InteropServices;
+using System.Text;
+using Microsoft.Win32.SafeHandles;
+namespace TalosWin {
+  public static class FinalPath {
+    [DllImport("kernel32.dll", CharSet = CharSet.Unicode, SetLastError = true)]
+    static extern SafeFileHandle CreateFileW(string name, uint access, uint share, IntPtr sa, uint disposition, uint flags, IntPtr template);
+    [DllImport("kernel32.dll", CharSet = CharSet.Unicode, SetLastError = true)]
+    static extern uint GetFinalPathNameByHandleW(SafeFileHandle handle, StringBuilder buffer, uint length, uint flags);
+    // the path Windows itself resolves a folder to: links, junctions, subst drives and 8.3 names all followed. null if it
+    // cannot be opened. FILE_FLAG_BACKUP_SEMANTICS (0x02000000) is what opens a folder; access 0 reads nothing in it.
+    public static string Of(string path) {
+      using (SafeFileHandle h = CreateFileW(path, 0, 7, IntPtr.Zero, 3, 0x02000000, IntPtr.Zero)) {
+        if (h.IsInvalid) return null;
+        StringBuilder sb = new StringBuilder(32768);
+        uint n = GetFinalPathNameByHandleW(h, sb, (uint)sb.Capacity, 0);
+        if (n == 0 || n >= sb.Capacity) return null;
+        return sb.ToString();
+      }
+    }
+  }
+}
+'@
+}
+
+<#
+  The folder to share, as Windows resolves it, or a throw that says why not (R1-4). Refused: not a folder; a link, junction
+  or other reparse point in ANY part of the path (C:\Users\you\Projects as a junction to C:\Windows passes a check of the
+  last part alone); a network folder. What is returned is the real path (8.3 names and subst drives resolved), and that is
+  what talos-wsl.sh then checks against its own refusals.
+#>
+function Resolve-TalosShareFolder([string]$Path) {
+  $item = Get-Item -LiteralPath $Path -Force -ErrorAction SilentlyContinue
+  if (-not $item -or -not $item.PSIsContainer) { throw "not a folder: $Path" }
+  $full = $item.FullName.TrimEnd('\')
+  if ($full -match '^\\\\') { throw 'a network folder is not shared' }
+  # every part from the drive down: C:\Users, C:\Users\you, C:\Users\you\Projects, ...
+  $parts = $full -split '\\'
+  for ($i = 1; $i -lt $parts.Count; $i++) {
+    $at = ($parts[0..$i] -join '\')
+    $p = Get-Item -LiteralPath $at -Force -ErrorAction SilentlyContinue
+    if (-not $p) { throw "cannot read $at" }
+    if ($p.Attributes -band [IO.FileAttributes]::ReparsePoint) {
+      throw "$at is a link, junction or cloud placeholder; share the real folder it points to instead"
+    }
+  }
+  return Get-TalosFinalPath $full
+}
+
+# C:\x as Windows resolves it (links, subst, 8.3 names followed), on a drive, or a throw
+function Get-TalosFinalPath([string]$Path) {
+  $final = [TalosWin.FinalPath]::Of($Path)
+  if (-not $final) { throw "Windows cannot resolve $Path" }
+  if ($final -match '^\\\\\?\\UNC\\') { throw 'a network folder is not shared' }
+  $final = $final -replace '^\\\\\?\\', ''
+  if ($final -notmatch '^[A-Za-z]:\\') { throw "$Path resolves to $final, which is not a folder on a drive" }
+  return $final.TrimEnd('\')
+}
+
+<#
+  A file for root inside the distro, with nothing in between that the talos user (or anyone) could swap (R1-2): its bytes
+  (LF line ends) as base64, and their SHA-256. install.ps1 hands both to a root shell as arguments; root decodes, checks the
+  hash and installs it root-owned. No file is left where another user could write first.
+#>
+function ConvertTo-TalosRootPayload([string]$Text) {
+  $bytes = (New-Object Text.UTF8Encoding $false).GetBytes(($Text -replace "`r`n", "`n"))
+  $sha = [Security.Cryptography.SHA256]::Create()
+  try { $hash = -join ($sha.ComputeHash($bytes) | ForEach-Object { $_.ToString('x2') }) } finally { $sha.Dispose() }
+  New-Object PSObject -Property @{ Base64 = [Convert]::ToBase64String($bytes); Sha256 = $hash }
+}
+# root's side of it: $1 the base64, $2 where it goes, $3 the hash. No quote marks at all: Windows PowerShell 5.1 drops them
+# from native arguments. The paths it is given have no spaces.
+$script:RootInstallSh = 'mkdir -p ${2%/*} && printf %s $1 | base64 -d > $2.tmp && [ $(sha256sum < $2.tmp | cut -c1-64) = $3 ] && install -m 755 -o root -g root $2.tmp $2; r=$?; rm -f $2.tmp; exit $r'
+
+# a git URL without its login (R1-5): https://user:token@host/x.git is https://host/x.git; nothing these scripts print, or
+# hand to the distro, carries a secret
+function Remove-TalosUrlLogin([string]$Url) { $Url -replace '^([A-Za-z][A-Za-z0-9+.-]*://)[^/@]*@', '$1' }
+
+# whether this distro is one Talos made (R1-7)
+function Test-TalosDistro([string]$Distro) {
+  $ErrorActionPreference = 'Continue'
+  & $script:WslExe -d $Distro -u root --exec /usr/bin/test -f $script:TalosMarker 2>&1 | Out-Null
+  return ($LASTEXITCODE -eq 0)
+}
diff --git a/apps/windows/add-folder.ps1 b/apps/windows/add-folder.ps1
index 3f7dc953..1be65a7e 100644
--- a/apps/windows/add-folder.ps1
+++ b/apps/windows/add-folder.ps1
@@ -1,36 +1,42 @@
 <#
 .SYNOPSIS
   Shares one Windows folder with the Talos distro, for a thread that needs it (docs/WINDOWS-PLAN.md section 8). None is shared
-  by default. It is mounted at /mnt/win/<name>, read-write, owned by the talos user; give that path to the thread as its
-  folder. System folders, AppData, a whole profile and whole drives are refused.
+  by default. It is mounted at /mnt/win/<name>, owned by the talos user; give that path to the thread as its folder.
+  Refused: system folders, AppData and other programs' data, key folders (.ssh, .aws, ...), a whole profile, whole drives,
+  network folders, Talos's own files, and any path with a link or junction in it.
+
+  Read-write (the default) means the thread can change anything in the folder. In a git repository that includes .git\hooks:
+  a hook the thread wrote runs on Windows, as you, the next time you run git there yourself. Share a repository you also
+  work in from Windows with -ReadOnly, or check .git\hooks before running git in it.
 
 .EXAMPLE
-  powershell -ExecutionPolicy Bypass -File apps\windows\add-folder.ps1 'C:\Users\you\Projects\atlas'
-  powershell -ExecutionPolicy Bypass -File apps\windows\add-folder.ps1 -List
-  powershell -ExecutionPolicy Bypass -File apps\windows\add-folder.ps1 -Remove /mnt/win/atlas
+  powershell -ExecutionPolicy Bypass -File add-folder.ps1 'C:\Users\you\Projects\atlas'
+  powershell -ExecutionPolicy Bypass -File add-folder.ps1 'C:\Users\you\Projects\atlas' -ReadOnly
+  powershell -ExecutionPolicy Bypass -File add-folder.ps1 -List
+  powershell -ExecutionPolicy Bypass -File add-folder.ps1 -Remove /mnt/win/atlas
 #>
 [CmdletBinding(DefaultParameterSetName = 'Add')]
 param(
   [Parameter(ParameterSetName = 'Add', Mandatory = $true, Position = 0)][string]$Path,
+  [Parameter(ParameterSetName = 'Add')][switch]$ReadOnly,
   [Parameter(ParameterSetName = 'List', Mandatory = $true)][switch]$List,
   [Parameter(ParameterSetName = 'Remove', Mandatory = $true)][string]$Remove,
   [string]$Distro = 'talos'
 )
 $ErrorActionPreference = 'Stop'
+. (Join-Path (Split-Path -Parent $MyInvocation.MyCommand.Path) 'TalosWin.ps1')
 $tool = '/opt/talos-wsl/talos-wsl.sh'
+function Fail([string]$m) { Write-Host "add-folder: $m" -ForegroundColor Red; exit 1 }
+if (-not (Test-TalosDistro $Distro)) { Fail "there is no Talos distro named $Distro (install.ps1 makes it)" }
 # --exec: the arguments reach the script as they are, never through a Linux shell (backslashes, spaces)
 switch ($PSCmdlet.ParameterSetName) {
-  'List' { & wsl.exe -d $Distro -u root --exec $tool folder-list }
-  'Remove' { & wsl.exe -d $Distro -u root --exec $tool folder-remove $Remove }
+  'List' { & $WslExe -d $Distro -u root --exec $tool folder-list }
+  'Remove' { & $WslExe -d $Distro -u root --exec $tool folder-remove $Remove }
   'Add' {
-    $item = Get-Item -LiteralPath $Path -ErrorAction SilentlyContinue
-    if (-not $item -or -not $item.PSIsContainer) { Write-Host "add-folder: not a folder: $Path" -ForegroundColor Red; exit 1 }
-    # the real folder, not a link or junction to somewhere else
-    if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {
-      Write-Host "add-folder: $Path is a link or junction; share the folder it points to instead" -ForegroundColor Red
-      exit 1
-    }
-    & wsl.exe -d $Distro -u root --exec $tool folder-add $item.FullName
+    # the real folder, as Windows resolves it, with no link or junction anywhere on the way (R1-4)
+    try { $real = Resolve-TalosShareFolder $Path } catch { Fail $_.Exception.Message }
+    if ($ReadOnly) { & $WslExe -d $Distro -u root --exec $tool folder-add --read-only $real }
+    else { & $WslExe -d $Distro -u root --exec $tool folder-add $real }
   }
 }
 exit $LASTEXITCODE
