@@ -0,0 +1,66 @@
+// The Instructions editor's client side: the relay carries the Mac's answer and could write anything into it, so an answer
+// for another thread, a sha that is not one, an over-cap text or a file with no sha to save over is refused, never shown or
+// saved over. The save sends the sha the editor loaded.
+import { AGENTS_MD_MAX_BYTES, AGENTS_MD_WORDING } from '@talos-app/protocol'
+import { describe, expect, it } from 'vitest'
+import { TalosClientError } from '../../src/lib/client.ts'
+import { createSocketAgentsMd, toAgentsMdFile } from '../../src/lib/socketAgentsMd.ts'
+
+const SHA = 'a'.repeat(64)
+const refused = (f: Record<string, unknown>) => {
+  try {
+    toAgentsMdFile(f, 'work')
+  } catch (e) {
+    expect(e).toBeInstanceOf(TalosClientError)
+    return (e as TalosClientError).message
+  }
+  return 'accepted'
+}
+
+describe('socket AGENTS.md client', () => {
+  it('takes the file as the Mac sent it for the thread asked', () => {
+    expect(
+      toAgentsMdFile({ thread_id: 'work', exists: true, sha: SHA, text: '# W\n', outside_diff: '@@ -1 +1 @@' }, 'work'),
+    ).toEqual({
+      threadId: 'work',
+      exists: true,
+      sha: SHA,
+      text: '# W\n',
+      tooLarge: false,
+      outsideDiff: '@@ -1 +1 @@',
+      saved: false,
+    })
+    expect(toAgentsMdFile({ thread_id: 'work', exists: false, sha: null }, 'work')).toMatchObject({
+      exists: false,
+      sha: null,
+    })
+    expect(toAgentsMdFile({ thread_id: 'work', exists: true, sha: null, too_large: true }, 'work')).toMatchObject({
+      tooLarge: true,
+      sha: null,
+    })
+  })
+
+  it('refuses an answer for another thread, a bad sha, an over-cap text, or a file with nothing to save over', () => {
+    expect(refused({ thread_id: 'general', exists: false, sha: null })).toBe(AGENTS_MD_WORDING.refused)
+    expect(refused({ thread_id: 'work', exists: true, sha: 'nope', text: 'x' })).toBe(AGENTS_MD_WORDING.refused)
+    expect(refused({ thread_id: 'work', exists: true, sha: SHA, text: 'x'.repeat(AGENTS_MD_MAX_BYTES + 1) })).toBe(
+      AGENTS_MD_WORDING.refused,
+    )
+    expect(refused({ thread_id: 'work', exists: true, sha: null, text: 'x' })).toBe(AGENTS_MD_WORDING.refused)
+    expect(refused({ thread_id: 'work', exists: true, sha: SHA })).toBe(AGENTS_MD_WORDING.refused)
+    expect(refused({ thread_id: 'work', sha: null })).toBe(AGENTS_MD_WORDING.refused)
+  })
+
+  it('a save sends the text and the sha the editor loaded', async () => {
+    const asked: Array<Record<string, unknown>> = []
+    const c = createSocketAgentsMd({
+      ask: async (f) => {
+        asked.push(f)
+        return { thread_id: 'work', exists: true, sha: SHA, text: f.text, saved: true }
+      },
+    })
+    await c.write('work', 'new\n', null)
+    expect(asked[0]).toMatchObject({ type: 'agents_md.write', thread_id: 'work', text: 'new\n', base_sha: null })
+    expect(typeof asked[0]?.request_id).toBe('string')
+  })
+})
