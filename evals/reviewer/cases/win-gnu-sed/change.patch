   root itself) and prints the path to give the thread as its folder.
 - `uninstall.ps1`: the logon task always; the distro and its files only when asked.
 
+**What the live runs on Titan found** (a throwaway distro, removed after; each is handled in the code and, where it can be,
+tested in `scripts/windows-distro.test.ts`):
+
+- Once systemd runs, a file Windows writes to `\\wsl.localhost\<distro>\tmp` is not seen inside, so files are handed over in
+  `/var/tmp/talos-install`.
+- Windows PowerShell 5.1 drops the double quotes inside arguments to `wsl.exe`, so nothing quoted is passed: checks run as
+  subcommands of `talos-wsl.sh` (`isolation`) through `wsl --exec`, which also keeps backslashes and spaces in folder paths.
+- With `ErrorActionPreference Stop`, a redirected native stderr line ends a 5.1 script; reading `wsl.exe` output never throws.
+- An empty `/mnt/c` folder is not a mount: the isolation check reads `/proc/mounts`.
+- The Linux `install.sh` needs Claude Code in the distro: `setup-user.sh` installs it with Anthropic's installer; signing in
+  is the owner's once (`wsl -d talos -- claude`; interop is off, so it prints a link).
+- The supervisor needs `supervisor.json` (`agent_dir`, and the Mac's `desktop.json` flags); without it it restarts every few
+  seconds while systemd says "active". `setup-user.sh` writes it once and requires 10 s with no new restart.
+- A shared folder deleted on the Windows side broke the next start, the systemd user session for `talos` (the supervisor's)
+  included. Every share is `nofail`.
+- `awk -v` turned the escaped spaces of a stored share back into spaces, so sharing a folder with spaces twice made a second
+  mount; compared through `ENVIRON` now.
+- The keep-alive held the distro for 3 minutes with nothing else attached, and had it running again 20 s after a forced stop.
+
 **Step 2: the tray** (keep-alive and status only): after step 1 is reviewed.
diff --git a/scripts/windows-distro.test.ts b/scripts/windows-distro.test.ts
new file mode 100644
index 00000000..4a6bfad5
--- /dev/null
+++ b/scripts/windows-distro.test.ts
@@ -0,0 +1,167 @@
+// Windows step 1 (docs/WINDOWS-PLAN.md section 8): the setup that runs inside the `talos` WSL distro, as root. These run the
+// real script against a scratch root (TALOS_WSL_ROOT), so what it writes to /etc is checked here, on Linux, without a distro.
+import { spawnSync } from 'node:child_process'
+import { existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterEach, beforeEach, describe, expect, it } from 'vitest'
+import { ROOT } from './size-report.ts'
+
+const SCRIPT = join(ROOT, 'apps', 'windows', 'distro', 'talos-wsl.sh')
+let root: string
+beforeEach(() => {
+  root = mkdtempSync(join(tmpdir(), 'talos-wsl-'))
+  mkdirSync(join(root, 'etc'))
+})
+afterEach(() => rmSync(root, { recursive: true, force: true }))
+
+function run(...args: string[]) {
+  const r = spawnSync('bash', [SCRIPT, ...args], {
+    env: {
+      PATH: process.env.PATH ?? '/usr/bin:/bin',
+      TALOS_WSL_ROOT: root,
+      TALOS_WSL_UID: '1000',
+      TALOS_WSL_GID: '1000',
+    },
+    encoding: 'utf8',
+  })
+  return { code: r.status, out: r.stdout, err: r.stderr }
+}
+const etc = (f: string) => readFileSync(join(root, 'etc', f), 'utf8')
+const fstabLines = () =>
+  existsSync(join(root, 'etc', 'fstab'))
+    ? etc('fstab')
+        .split('\n')
+        .filter((l) => l.includes('drvfs'))
+    : []
+
+describe('wsl.conf', () => {
+  it('turns interop and automount off, systemd on, mounts what fstab lists, and logs in as talos', () => {
+    expect(run('wsl-conf').code).toBe(0)
+    const conf = etc('wsl.conf')
+    for (const line of [
+      '[boot]',
+      'systemd=true',
+      '[user]',
+      'default=talos',
+      '[interop]',
+      'enabled=false',
+      'appendWindowsPath=false',
+      '[automount]',
+      'mountFsTab=true',
+    ])
+      expect(conf.split('\n')).toContain(line)
+    // interop and automount are both off: `enabled=false` under each
+    expect(conf).toMatch(/\[interop\]\nenabled=false/)
+    expect(conf).toMatch(/\[automount\]\nenabled=false/)
+  })
+
+  it('keeps a wsl.conf it did not write, as a backup, and is a no-op the second time', () => {
+    writeFileSync(join(root, 'etc', 'wsl.conf'), '[network]\nhostname=mine\n')
+    expect(run('wsl-conf').code).toBe(0)
+    expect(readFileSync(join(root, 'etc', 'wsl.conf.before-talos'), 'utf8')).toBe('[network]\nhostname=mine\n')
+    const first = etc('wsl.conf')
+    const again = run('wsl-conf')
+    expect(again.code).toBe(0)
+    expect(again.out).toContain('already')
+    expect(etc('wsl.conf')).toBe(first)
+  })
+})
+
+describe('the isolation check install.ps1 runs after the restart', () => {
+  const proc = (interop: boolean, mounts: string) => {
+    mkdirSync(join(root, 'proc', 'sys', 'fs', 'binfmt_misc'), { recursive: true })
+    if (interop) writeFileSync(join(root, 'proc', 'sys', 'fs', 'binfmt_misc', 'WSLInterop'), 'enabled\n')
+    writeFileSync(join(root, 'proc', 'mounts'), mounts)
+  }
+  const ROOTFS = '/dev/sdc / ext4 rw,relatime 0 0\n'
+  const DRIVERS = 'drivers /usr/lib/wsl/drivers 9p ro,nosuid,nodev 0 0\n'
+
+  it('passes with no interop and no Windows drive mounted (an empty /mnt/c folder is not a mount)', () => {
+    proc(false, ROOTFS + DRIVERS)
+    mkdirSync(join(root, 'mnt', 'c'), { recursive: true })
+    const r = run('isolation')
+    expect(r.code).toBe(0)
+    expect(r.out.trim()).toBe('isolated: interop off, no Windows drive mounted')
+  })
+
+  it('fails when interop is registered, or a drive is mounted, and says which', () => {
+    proc(true, ROOTFS)
+    expect(run('isolation')).toMatchObject({ code: 1 })
+    expect(run('isolation').err).toContain('interop is on')
+    rmSync(join(root, 'proc'), { recursive: true })
+    proc(false, `${ROOTFS}C:\\134 /mnt/c 9p rw,noatime,aname=drvfs 0 0\n`)
+    expect(run('isolation').err).toContain('/mnt/c')
+  })
+
+  it('a folder the owner shared, at /mnt/win/<name>, is not a whole drive', () => {
+    proc(false, `${ROOTFS}C:/Users/alex/Projects/atlas /mnt/win/atlas 9p rw,aname=drvfs 0 0\n`)
+    expect(run('isolation').code).toBe(0)
+  })
+})
+
+describe('a Windows folder for a thread', () => {
+  it('is one drvfs line in fstab, owned by talos, at /mnt/win/<name>, with spaces escaped', () => {
+    const r = run('folder-add', 'C:\\Users\\alex\\My Projects\\Atlas App')
+    expect(r.code).toBe(0)
+    expect(r.out.trim().split('\n').at(-1)).toBe('/mnt/win/atlas-app')
+    expect(fstabLines()).toEqual([
+      // nofail: a folder deleted on the Windows side must not stop the distro's start or its systemd user session
+      'C:/Users/alex/My\\040Projects/Atlas\\040App /mnt/win/atlas-app drvfs metadata,nofail,uid=1000,gid=1000,umask=022,fmask=011 0 0',
+    ])
+  })
+
+  it('the same folder twice is one line; another folder with the same name gets its own', () => {
+    run('folder-add', 'C:\\Users\\alex\\Projects\\atlas')
+    expect(run('folder-add', 'c:\\users\\alex\\projects\\atlas\\').out.trim().split('\n').at(-1)).toBe('/mnt/win/atlas')
+    expect(fstabLines()).toHaveLength(1) // Windows paths fold case, and a trailing backslash is the same folder
+    expect(run('folder-add', 'D:\\Work\\atlas').out.trim().split('\n').at(-1)).toBe('/mnt/win/atlas-2')
+    expect(fstabLines()).toHaveLength(2)
+  })
+
+  it('a folder with spaces shared twice is still one line (found live on Titan: the escaped spaces did not compare)', () => {
+    run('folder-add', 'C:\\Users\\Public\\Documents\\Talos E2E Test')
+    const again = run('folder-add', 'C:\\Users\\Public\\Documents\\Talos E2E Test')
+    expect(again.out).toContain('already shared')
+    expect(again.out.trim().split('\n').at(-1)).toBe('/mnt/win/talos-e2e-test')
+    expect(fstabLines()).toHaveLength(1)
+  })
+
+  it('refuses a drive root, the system folders, AppData and a whole profile', () => {
+    for (const bad of [
+      'C:\\',
+      'C:',
+      'C:\\Windows',
+      'C:\\Windows\\System32',
+      'C:\\Program Files\\App',
+      'C:\\Program Files (x86)',
+      'C:\\ProgramData\\x',
+      'C:\\Users\\alex',
+      'C:\\Users\\alex\\AppData\\Roaming',
+      'C:\\Users',
+      'relative\\path',
+      '\\\\server\\share\\x',
+      'C:\\Users\\alex\\..\\bob\\x',
+    ]) {
+      const r = run('folder-add', bad)
+      expect(r.code, bad).not.toBe(0)
+      expect(r.err, bad).toMatch(/not shared/)
+    }
+    expect(fstabLines()).toEqual([])
+  })
+
+  it('leaves every other fstab line alone, and remove takes out only its own', () => {
+    writeFileSync(join(root, 'etc', 'fstab'), 'LABEL=cloudimg-rootfs / ext4 defaults 0 1\n')
+    run('folder-add', 'C:\\Users\\alex\\Projects\\atlas')
+    run('folder-add', 'C:\\Users\\alex\\Projects\\notes')
+    expect(run('folder-remove', '/mnt/win/atlas').code).toBe(0)
+    expect(etc('fstab')).toContain('LABEL=cloudimg-rootfs / ext4 defaults 0 1')
+    expect(fstabLines().map((l) => l.split(' ')[1])).toEqual(['/mnt/win/notes'])
+    expect(run('folder-remove', '/mnt/win/nothing-here').code).not.toBe(0)
+  })
+
+  it('folder-list prints each mounted Windows folder and where it is', () => {
+    run('folder-add', 'C:\\Users\\alex\\Projects\\atlas')
+    expect(run('folder-list').out.trim()).toBe('/mnt/win/atlas\tC:\\Users\\alex\\Projects\\atlas')
+  })
+})
