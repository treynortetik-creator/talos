index 00000000..b16202aa
--- /dev/null
+++ b/scripts/gate-push.sh
@@ -0,0 +1,160 @@
+#!/usr/bin/env bash
+# The one way to push (scripts/gate.sh --push [<remote> [<branch>]], default origin main): rebase, gate, push, and when the
+# push loses a race (main moved while the gate ran), rebase and push again without running the whole gate twice for nothing.
+#   1. Refuses with a rebase in progress or uncommitted changes (the gate checks the files on disk).
+#   2. Takes the push lease, refs/locks/push on the remote (advisory: a plain push ignores it): a parentless commit with an
+#      empty tree whose message names the machine and the time it runs out. Taken and renewed with --force-with-lease, so two
+#      machines cannot both hold it; one held by another machine is waited on (every 15 s, up to 20 min), an expired one is
+#      taken over. Released at the end, and on Ctrl-C. A remote that refuses the ref means no lease: the push goes on.
+#   3. Fetches, rebases onto <remote>/<branch>, runs the gate, and records what passed in .git/talos-gate.pass: the tree, the
+#      base, the plan and the sha256 of gate.sh and pre-push.sh. The pre-push hook trusts that stamp for that exact tree (and
+#      runs the gate itself for anything else), so the push does not run the gate a second time.
+#   4. Pushes. Rejected because the branch moved: fetch, rebase, and look at what the new commits on the branch changed. When
+#      they touch none of this change's files, none of the tests its plan runs, nothing everything depends on, and nothing
+#      under a test root its plan runs from, only typecheck, lint, personal and size run again (CI runs every suite after the
+#      merge); otherwise the whole touched set runs again. At most 3 tries; a rebase conflict stops at once.
+set -uo pipefail
+cd "$(git rev-parse --show-toplevel)" || exit 2
+
+REMOTE="${1:-origin}"
+BRANCH="${2:-main}"
+LOCK=refs/locks/push
+MACHINE="${TALOS_MACHINE:-$(hostname -s 2>/dev/null || echo unknown)}"
+LEASE_S="${GATE_PUSH_LEASE_S:-600}"     # how long a lease holds
+WAIT_S="${GATE_PUSH_WAIT_S:-1200}"      # how long to wait for another machine's lease
+POLL_S="${GATE_PUSH_POLL_S:-15}"
+RENEW_S="${GATE_PUSH_RENEW_S:-420}"     # a gate past this renews the lease before the push
+TRIES=3
+GIT_DIR_ABS="$(git rev-parse --absolute-git-dir)"
+STAMP="$GIT_DIR_ABS/talos-gate.pass"
+EMPTY_TREE="$(git hash-object -t tree /dev/null)"
+
+say() { printf 'gate-push: %s\n' "$*" >&2; }
+refuse() {
+  say "REFUSED: $*"
+  exit 1
+}
+sha256() { shasum -a 256 "$1" 2>/dev/null | cut -d' ' -f1; }
+rebasing() { [ -d "$GIT_DIR_ABS/rebase-merge" ] || [ -d "$GIT_DIR_ABS/rebase-apply" ]; }
+
+# ---- the lease ------------------------------------------------------------------------------------------------------------
+LEASE="" # the lease commit this run holds
+lease_seen() { git ls-remote "$REMOTE" "$LOCK" 2>/dev/null | cut -f1; }
+lease_field() { # lease_field <sha> <key>: a key=value line of the lease's message
+  git fetch -q "$REMOTE" "$LOCK" 2>/dev/null
+  git log -1 --format=%B "$1" 2>/dev/null | sed -n "s/^$2=//p" | head -1
+}
+lease_put() { # lease_put <expected sha or ''>: a new lease over exactly that one; prints the new sha on success
+  local new
+  new="$(printf 'talos push lease\n\nmachine=%s\nuntil=%s\nuntil_iso=%s\npid=%s\n' "$MACHINE" "$(($(date +%s) + LEASE_S))" \
+    "$(date -u -r $(($(date +%s) + LEASE_S)) +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u +%Y-%m-%dT%H:%M:%SZ)" "$$" |
+    git commit-tree "$EMPTY_TREE")" || return 2
+  git push -q --force-with-lease="$LOCK:$1" "$REMOTE" "$new:$LOCK" >/dev/null 2>&1 || return 1
+  echo "$new"
+}
+lease_take() {
+  local waited=0 seen until who got
+  while :; do
+    seen="$(lease_seen)"
+    if [ -n "$seen" ] && [ "$seen" != "$LEASE" ]; then
+      until="$(lease_field "$seen" until)"
+      who="$(lease_field "$seen" machine)"
+      if [ -n "$until" ] && [ "$until" -gt "$(date +%s)" ] 2>/dev/null; then
+        [ "$waited" -lt "$WAIT_S" ] || refuse "the push lease is held by ${who:-another machine} until $(lease_field "$seen" until_iso); try again then"
+        say "the push lease is held by ${who:-another machine} until $(lease_field "$seen" until_iso): waiting"
+        sleep "$POLL_S"
+        waited=$((waited + POLL_S))
+        continue
+      fi
+      [ -z "$until" ] || say "the lease of ${who:-another machine} ran out: taking it over"
+    fi
+    if got="$(lease_put "${seen:-}")"; then
+      LEASE="$got"
+      return 0
+    fi
+    # lost a race for it, or the remote does not take the ref: look again once, then go on without a lease
+    if [ -z "$(lease_seen)" ] && ! lease_put "" >/dev/null; then
+      say "the remote does not take $LOCK: pushing without a lease"
+      return 0
+    fi
+  done
+}
+lease_release() {
+  [ -n "$LEASE" ] || return 0
+  git push -q --force-with-lease="$LOCK:$LEASE" "$REMOTE" ":$LOCK" >/dev/null 2>&1 || true
+  LEASE=""
+}
+trap 'lease_release' EXIT
+trap 'exit 130' INT TERM
+
+# ---- one pass of the gate, stamped ----------------------------------------------------------------------------------------
+plan_of() { bash scripts/gate.sh --plan --base "$1" 2>/dev/null; }
+gate_and_stamp() { # gate_and_stamp <base> <full|cheap>
+  local base="$1" mode="$2" plan
+  if [ "$mode" = cheap ]; then bash scripts/gate.sh --base "$base" --checks-only || refuse "the gate failed (above)"
+  else bash scripts/gate.sh --base "$base" || refuse "the gate failed (above)"; fi
+  plan="$(plan_of "$base")"
+  {
+    echo "tree=$(git rev-parse 'HEAD^{tree}')"
+    echo "base=$base"
+    echo "plan=$(printf '%s' "$plan" | shasum -a 256 | cut -d' ' -f1)"
+    echo "gate=$(sha256 scripts/gate.sh)"
+    echo "hook=$(sha256 scripts/pre-push.sh)"
+    echo "mode=$mode"
+    echo "at=$(date +%s)"
+  } >"$STAMP.tmp" && mv "$STAMP.tmp" "$STAMP"
+}
+
+# When the branch moved from <old> to <new>: cheap when what it brought touches nothing this change's gate depends on.
+race_mode() {
+  local old="$1" new="$2" f mine planned roots r
+  mine="$(git diff --name-only "$new" HEAD)"
+  planned="$(plan_of "$new" | sed -n 's/^\t//p')"
+  roots=""
+  for r in packages/protocol packages/testkit packages/integrations apps/relay apps/web apps/mobile scripts apps/bridge e2e; do
+    if printf '%s\n' "$planned" | grep -Eq "^(${r}/|tests/)"; then roots="$roots $r"; fi
+  done
+  plan_of "$new" | grep -Eq '^(vitest-all|bun-all|e2e-all)$' && { echo full; return; }
+  while IFS= read -r f; do
+    [ -n "$f" ] || continue
+    if printf '%s\n' "$mine" "$planned" | grep -Fxq "$f"; then echo full; return; fi
+    case "$f" in
+      packages/protocol/* | packages/testkit/* | package.json | */package.json | pnpm-lock.yaml | tsconfig*.json | */tsconfig*.json | \
+        biome.json | vitest.config.ts | scripts/gate.sh | scripts/gate-push.sh | scripts/pre-push.sh)
+        echo full
+        return
+        ;;
+    esac
+    for r in $roots; do case "$f" in "$r"/*) echo full && return ;; esac; done
+  done < <(git diff --name-only "$old" "$new")
+  echo cheap
+}
+
+# ---- the push -------------------------------------------------------------------------------------------------------------
+rebasing && refuse "a rebase is in progress: finish or abort it first"
+[ -z "$(git status --porcelain --untracked-files=no)" ] || refuse "there are uncommitted changes: the gate checks the files on disk, so commit or stash them"
+lease_take
+
+mode=full base=""
+for try in $(seq 1 "$TRIES"); do
+  git fetch -q "$REMOTE" "$BRANCH" || refuse "cannot fetch $REMOTE $BRANCH"
+  new="$(git rev-parse "$REMOTE/$BRANCH")" || refuse "no $REMOTE/$BRANCH"
+  [ -z "$base" ] || mode="$(race_mode "$base" "$new")"
+  if ! git rebase -q "$new" >/dev/null 2>&1; then
+    git rebase --abort >/dev/null 2>&1
+    refuse "the rebase onto $REMOTE/$BRANCH has conflicts: rebase by hand, then push again"
+  fi
+  base="$new"
+  [ "$try" = 1 ] || say "the branch moved: $( [ "$mode" = cheap ] && echo "the new commits touch nothing this change's tests depend on, so only typecheck, lint, personal and size run again" || echo "running the touched set again")"
+  started=$SECONDS
+  gate_and_stamp "$base" "$mode"
+  [ $((SECONDS - started)) -lt "$RENEW_S" ] || [ -z "$LEASE" ] || { got="$(lease_put "$LEASE")" && LEASE="$got"; }
+  out="$(git push "$REMOTE" "HEAD:$BRANCH" 2>&1)"
+  rc=$?
+  printf '%s\n' "$out" >&2
+  [ "$rc" = 0 ] && { say "pushed"; exit 0; }
+  # only a lost race is tried again; any other refusal (the hook, permissions) is the answer
+  printf '%s' "$out" | grep -Eq 'fetch first|non-fast-forward|cannot lock ref|stale info|\[rejected\]' ||
+    refuse "the push was refused (above)"
+done
+refuse "the branch kept moving: $TRIES tries"
