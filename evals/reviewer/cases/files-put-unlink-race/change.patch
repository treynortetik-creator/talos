+/**
+ * An exclusive create (O_CREAT|O_EXCL) whose handle is somewhere else than asked made that file, wherever it landed. Linux
+ * has no O_NOFOLLOW_ANY: O_NOFOLLOW covers only the last part of the path, so a folder swapped for a link between the fence
+ * and the open is followed, and the empty file is created outside (found on Titan: files-put.test.ts). It is taken out
+ * again, and only it: at the place the handle really is, the same file (device and inode), a regular file, still empty. For a
+ * moment an empty file exists out there; a full fix needs openat on a checked folder handle, which Node does not have
+ * (docs/SECURITY.md, "Upload into a thread's folder"). On macOS O_NOFOLLOW_ANY refuses the open itself, so this never runs.
+ */
+function undoCreate(fd: number, where: string, extraFlags: number): void {
+  const exclusive = constants.O_CREAT | constants.O_EXCL
+  if ((extraFlags & exclusive) !== exclusive) return
+  try {
+    const mine = fstatSync(fd)
+    const there = lstatSync(where)
+    if (there.isFile() && there.dev === mine.dev && there.ino === mine.ino && there.size === 0 && mine.size === 0)
+      unlinkSync(where)
+  } catch {
+    // gone already, or not ours to touch
+  }
+}
