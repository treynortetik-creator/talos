# Copy to ~/.config/talos/notify.env, chmod 600, and fill in. Never commit the real file.
# Create a bot with @BotFather to get the token. Send your bot a message, then read your chat id
# from https://api.telegram.org/bot<token>/getUpdates (do this in a browser, not in a chat with the agent).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
