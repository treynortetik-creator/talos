# Talos relay: every environment variable (docs/SETUP.md explains each one in plain words).
# On Railway you set these in the service's Variables tab; this file is only a checklist. Never commit a real .env.
# The relay refuses to start if a required value is missing or malformed and says which one.

# --- Required -------------------------------------------------------------------------------------------------------

# Always "production" when deployed.
NODE_ENV=production

# The public address of your relay, with https:// and no path. Railway shows it under Settings > Networking.
# Changing it later (for example to a custom domain) voids every passkey and enrolled device (docs/SETUP.md).
PUBLIC_ORIGIN=https://your-relay.up.railway.app

# The same host with no https:// and no port.
RP_ID=your-relay.up.railway.app

# 32 random bytes, base64. Encrypts everything the relay stores. Generate with: openssl rand -base64 32
# Keep a copy somewhere safe: without it the stored data cannot be read.
DATA_KEY=

# Web push keys. Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Apple rejects anything that is not mailto: or https:. Use an address you read.
VAPID_SUBJECT=mailto:you@example.com

# --- Set after the Mac has run `talos-app init` -----------------------------------------------------------------------

# The Mac's bridge public key (43 characters). `talos-app init` prints the exact line to paste.
BRIDGE_PUBKEY=
# 0 normally. 1 = the key above always wins over a rotated key (recovery only).
BRIDGE_PUBKEY_FORCE=0

# --- Optional, with defaults ------------------------------------------------------------------------------------------

# Railway sets PORT for you. Locally it defaults to 8080.
# PORT=8080

# Where the database and uploaded media live. The Dockerfile sets /data; mount the Railway volume there.
DATA_DIR=/data

# Name shown by the passkey prompt.
RP_NAME=Talos

# Live voice. Leave OPENAI_API_KEY empty to switch live voice off.
OPENAI_API_KEY=
VOICE_MODEL=gpt-live-1
# Daily and per-call limits, in minutes.
VOICE_DAILY_MAX_MIN=60
VOICE_SESSION_MAX_MIN=30
# Dictation (the composer's dictate button) uses the same key. Leave these unset to use the defaults.
# TRANSCRIBE_MODEL=gpt-transcribe
# DICTATE_DAILY_MAX_MB=100
# DICTATE_TIMEOUT_S=90
# OPENAI_BASE_URL=

# How many days the relay keeps messages for a Mac that is offline (1 to 90).
BUFFER_DAYS=7

# Largest upload in megabytes (1 to 500), and the volume size at which the relay warns you with a notification.
MEDIA_MAX_MB=50
VOLUME_SOFT_CAP_MB=800

# Upload budgets: how many uploads an hour, and how many megabytes in any 24 hours, before the relay answers "slow down".
# These are today's limits; raise them if you send many files at once.
MEDIA_UPLOADS_PER_HOUR=60
MEDIA_DAILY_MAX_MB=200

# How long a sign-in lasts (days), and how long it may sit unused before it ends. The unused time cannot be longer than the
# sign-in itself, or the relay refuses to start.
SESSION_TTL_DAYS=30
SESSION_IDLE_DAYS=14

# How many proxies sit in front of the relay. 1 on Railway. Used to find the real client address for rate limits.
TRUST_PROXY_HOPS=1

# "allow" lets you connect work accounts (they are still off until you switch them on in the app). "off" blocks them all.
WORK_INTEGRATIONS=allow

# 0 (default for now): a device enrolled before device proof that has not been opened since still signs in without it, until it
# proves its key (it does so on its next page load); after that the relay always asks. 1: every sign-in that names a device must
# prove it. Settings > Devices shows "Key not verified" for the rest; after you deploy, open or revoke each of those, then switch to 1.
# The default is 0 today. Left commented out so a copy of this file follows the default if a later release changes it.
# DEVICE_PROOF_REQUIRED=0

# fatal, error, warn, info, debug, trace or silent. The relay never logs message text, tokens or codes at any level.
LOG_LEVEL=info

# --- Health alarms and share (docs/V2-FEATURES.md V1.4) --------------------------------------------------------------

# Optional ntfy topic (https://) for alarm pushes that don't depend on Web Push, and its bearer if the topic is protected.
ALERT_NTFY_URL=
ALERT_NTFY_TOKEN=
# Minutes without a sync before the Talos mod counts as quiet.
MOD_QUIET_MIN=10
# Minimum minutes between two "Mac session stopped" pushes (a laptop that sleeps is normal).
MAC_ALERT_MIN_GAP_MIN=120
# 1 = share from other apps is on; 0 = every /api/share route answers 404.
SHARE_ENABLED=1

# --- Not read by the relay; used by the Dockerfile ------------------------------------------------------------------------

# Folder with the built web app. The Dockerfile sets /app/web. Leave unset when running the API alone.
# TALOS_WEB_DIR=/app/web

# Native iPhone push (APNs, docs/IOS-PUSH.md). All four or none; leave empty until the paid Apple program key exists.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_P8=
APNS_BUNDLE_ID=
# APNS_TEAM_ID + APNS_BUNDLE_ID alone also switch on /.well-known/apple-app-site-association (passkeys inside the iPhone app).
