<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The hardened-runtime build (build-app.sh with its hardened option, as release-app.sh runs it). Under the hardened runtime macOS refuses these resources,
     with no prompt, to Talos and to the agent's programs it is responsible for, unless the app holds the entitlement. A local build
     (entitlements.plist, no hardened runtime) has them all already; these keep the prebuilt app the same. Each one matches a usage
     string in Info.plist.template. Nothing else: no JIT, no unsigned memory, no DYLD variables, library validation stays on. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.automation.apple-events</key><true/>
  <key>com.apple.security.device.audio-input</key><true/>
  <key>com.apple.security.device.camera</key><true/>
  <key>com.apple.security.personal-information.addressbook</key><true/>
  <key>com.apple.security.personal-information.photos-library</key><true/>
</dict>
</plist>
