{
  "name": "@talos-app/bridge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "bun run $PWD/src/server.ts",
    "test": "bun test --timeout 30000",
    "cli": "bun run $PWD/src/cli.ts",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "capture:schedules": "bun run scripts/capture-schedules.ts",
    "capture:search": "bun run scripts/capture-search.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.299",
    "@anthropic-ai/sdk": "0.134.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@talos-app/protocol": "workspace:*",
    "uqr": "0.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@talos-app/testkit": "workspace:*",
    "@types/bun": "1.3.14"
  },
  "bin": {
    "talos-app": "src/cli.ts",
    "talos": "src/talos.ts"
  }
}
