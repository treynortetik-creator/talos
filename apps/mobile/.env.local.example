# Copy to apps/mobile/.env.local (gitignored) for local builds. A real environment variable wins over this file.
# The relay origin the shell loads: https only (plain http only for localhost). Origin only: no path, query or fragment.
TALOS_RELAY_URL=https://your-relay.example
# Dev only, loopback http relay: set to 1 to allow cleartext (Android-only in Capacitor; iOS ATS has no exceptions).
# TALOS_DEV_CLEARTEXT=1
