  "must_throw": [
    {
      "name": "a lone surrogate in a string",
      "input": {
        "v": 1,
        "argv": [
          "\ud800x"
        ],
        "env": {},
        "files": {}
      },
      "note": "RFC 8785 cannot write it: throw"
    },
    {
      "name": "a lone surrogate in a key",
      "input": {
        "v": 1,
        "argv": [],
        "env": {
          "\udc00": "1"
        },
        "files": {}
      },
      "note": "throw"
    },
    {
      "name": "NaN",
      "input": {
        "v": 1,
        "argv": [],
        "env": {},
        "files": {},
        "extra": 0
      },
      "replace": {
        "path": [
          "extra"
        ],
        "with": "NaN"
      },
      "note": "JSON has no NaN: the test puts NaN at `path`; throw"
    },
    {
      "name": "an infinity",
      "input": {
        "v": 1,
        "argv": [],
        "env": {},
        "files": {},
        "extra": 0
      },
