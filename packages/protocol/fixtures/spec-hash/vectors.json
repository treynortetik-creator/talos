    {
      "name": "key order by UTF-16 code units",
      "note": "RFC 8785 3.2.3: the emoji (a surrogate pair) sorts before U+FB33, not after",
      "input": {
        "v": 1,
        "argv": [],
        "files": {},
        "env": {
          "\u20ac": "Euro Sign",
          "\r": "Carriage Return",
          "\ufb33": "Hebrew Letter Dalet With Dagesh",
          "1": "One",
          "\ud83d\ude00": "Emoji: Grinning Face",
          "\u0080": "Control",
          "\u00f6": "Latin Small Letter O With Diaeresis"
        }
      },
      "jcs": "{\"argv\":[],\"env\":{\"\\r\":\"Carriage Return\",\"1\":\"One\",\"\u0080\":\"Control\",\"\u00f6\":\"Latin Small Letter O With Diaeresis\",\"\u20ac\":\"Euro Sign\",\"\ud83d\ude00\":\"Emoji: Grinning Face\",\"\ufb33\":\"Hebrew Letter Dalet With Dagesh\"},\"files\":{},\"v\":1}",
