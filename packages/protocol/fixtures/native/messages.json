      },
      "json_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "companion_state"
          },
          "link": {
            "type": "string",
            "enum": [
              "connecting",
              "online",
              "offline",
              "unreachable"
            ]
          },
          "mac_online": {
            "type": "boolean"
          },
          "busy": {
            "type": "boolean"
          },
          "needs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99999
          },
          "working": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99999
          },
          "queued": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99999
          },
          "on_call": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99999
          },
          "unread": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99999
          },
          "failed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99999
          },
          "rows": {
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "thread_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,31}$"
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "needs_you",
                    "ready",
                    "working",
                    "queued",
                    "on_call"
                  ]
                }
              },
              "required": [
                "thread_id",
                "state"
              ],
              "additionalProperties": false
            }
          },
          "last_reply": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "thread_id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,31}$"
                  },
                  "seq": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "thread_id",
                  "seq"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "viewing": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,31}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "held": {
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "thread_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,31}$"
                },
                "seq": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "thread_id",
                "seq"
              ],
              "additionalProperties": false
            }
          },
          "replies_epoch": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "type",
          "link",
          "mac_online",
          "busy",
          "needs",
          "working",
          "queued",
          "on_call",
          "unread",
          "failed",
          "rows",
          "last_reply"
        ],
        "additionalProperties": false
      }
