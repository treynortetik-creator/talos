        "properties": {
          "type": {
            "type": "string",
            "const": "ready"
          },
          "shell_api": {
            "type": "number",
            "const": 1
          },
          "features": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "signed_in": {
            "type": "boolean"
          }
        },
