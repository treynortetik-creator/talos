        "claude_path": "/home/talos/.local/bin/claude",
        "args": [
          "--plugin-dir",
          "/home/talos/talos-app/plugins/talos-app-mod",
          "--dangerously-load-development-channels",
          "server:talos-app"
        ]
      },
      "fingerprint": "2c16465bd30e8f8ddf8c093c0967a9851be722e216650f6d67f9b296f0ecdfe2",
      "parts": {
