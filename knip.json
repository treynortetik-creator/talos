{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": ["scripts/*.{ts,mjs}", "!scripts/*.test.ts"],
      "project": ["scripts/**/*.{ts,mjs}"]
    },
    "apps/bridge": {
      "entry": [
        "src/cli.ts",
        "src/talos.ts",
        "src/server.ts",
        "src/worker/*.ts",
        "scripts/*.ts",
        "test/**/*.ts",
        "test-contract/**/*.ts"
      ],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts", "test-contract/**/*.ts"]
    },
    "apps/relay": {
      "entry": ["src/index.ts", "scripts/*.{ts,mjs}", "test/**/*.ts", "playwright.config.ts"],
      "project": ["src/**/*.ts", "scripts/**/*", "test/**/*.ts"],
      "ignoreDependencies": ["canonicalize", "ulid", "rss-parser", "fast-xml-parser"]
    },
    "apps/web": {
      "entry": ["src/main.tsx", "src/sw.ts", "vite.config.ts", "test/**/*.{ts,tsx}", "playwright.config.ts"],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@fontsource-variable/.*", "@types/markdown-it", "tailwindcss"]
    },
    "apps/mobile": {
      "entry": ["capacitor.config.ts", "scripts/*", "test/**/*.ts"],
      "project": ["scripts/**/*", "test/**/*.ts", "*.ts"],
      "ignoreDependencies": ["@capacitor/haptics", "@capacitor/keyboard"]
    },
    "packages/protocol": {
      "entry": [
        "src/index.ts",
        "src/guarded-fetch.ts",
        "scripts/*",
        "test/**/*.ts",
        "test-browser/**/*.ts",
        "playwright.config.ts"
      ],
      "project": ["src/**/*.ts", "scripts/**/*", "test/**/*.ts", "test-browser/**/*.ts"]
    },
    "packages/testkit": {
      "entry": ["src/index.ts", "test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/integrations": {
      "entry": ["src/index.ts", "src/setup-catalog.ts", "test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "e2e": {
      "entry": ["drive.ts", "tests/**/*.ts", "playwright.config.ts", "harness/drive-reporter.ts"],
      "project": ["**/*.ts"],
      "ignoreDependencies": ["@modelcontextprotocol/server-.*"]
    }
  }
}
